---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title, description = `${profile.name}，${profile.university}，研究兴趣为机器人系统。展示轮腿机器人、边缘视觉与数学建模项目。` } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} | ${profile.englishName}`;
const isNotFound = Astro.url.pathname === '/404/' || Astro.url.pathname === '/404.html';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={isNotFound ? 'noindex, follow' : 'index, follow'} />
    {!isNotFound && canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
