---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="site-brand" href="/">{profile.englishName}</a>
    <nav aria-label="主导航">
      <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
      <a href="/#projects">Projects</a>
      <a href="/#education">Education</a>
      <a href="/#awards">Awards</a>
      <a href="/#interests">Research Interests</a>
      <a href="/about/" aria-current={pathname === '/about/' ? 'page' : undefined}>About</a>
      <a href="/resume/" aria-current={pathname === '/resume/' ? 'page' : undefined}>CV</a>
    </nav>
    <div class="header-socials">
      <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub 主页"><Icon name="github" size={19} /></a>
      <a href={`mailto:${profile.email}`} aria-label="发送邮件"><Icon name="mail" size={19} /></a>
    </div>
  </div>
</header>
