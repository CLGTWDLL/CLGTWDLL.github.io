---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import VideoPanel from '../../components/VideoPanel.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project; }
const { project } = Astro.props;
const sections = [
  ['overview', '项目简介'], ['contribution', '我本人负责的工作'], ['design', '系统 / 模型设计'],
  ['results', '关键结果'], ['media', '图片 / 视频'], ['source', 'GitHub 链接'],
];
---
<BaseLayout title={project.name} description={project.summary}>
  <article class="container detail-page">
    <header class="detail-header">
      <a class="back-link" href="/#projects">← Selected Projects</a>
      <h1>{project.name}<span>{project.englishName}</span></h1>
      <p>{project.summary}</p>
      <nav class="detail-nav" aria-label="项目目录">{sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
    </header>
    <section id="overview" class="detail-section">
      <h2>项目简介</h2>{project.overview.map(text => <p>{text}</p>)}
    </section>
    <section id="contribution" class="detail-section">
      <h2>我本人负责的工作</h2>
      <ul>{project.contributions.map(item => <li><strong>{item.title}：</strong>{item.description}</li>)}</ul>
    </section>
    <section id="design" class="detail-section">
      <h2>系统 / 模型设计</h2>
      <ul>{project.design.map(item => <li><strong>{item.title}：</strong>{item.description}</li>)}</ul>
      <p class="muted">{project.designNote}</p>
    </section>
    <section id="results" class="detail-section">
      <h2>关键结果</h2>
      <dl class="result-list">{project.results.map(result => <div><dt>{result.metric}</dt><dd><strong>{result.value}</strong><p class="muted">{result.evidence}</p></dd></div>)}</dl>
      <p class="result-note">{project.resultNote}</p>
      <div class="project-links">{project.evidence.map(item => <a href={item.url}>{item.label} ↗</a>)}</div>
    </section>
    <section id="media" class="detail-section">
      <h2>图片 / 视频</h2>
      <MediaFrame src={project.image} alt={project.imageAlt} caption={project.imageCaption} />
      {project.secondaryImage && <MediaFrame src={project.secondaryImage} alt={project.secondaryAlt} caption={project.secondaryCaption} />}
      <VideoPanel url={project.videoUrl} />
      {!project.videoUrl && <p class="muted">暂无项目视频，当前展示已有项目图片{project.featured ? '和真实模型渲染。实机照片与演示视频待补充。' : '。演示视频待补充。'}</p>}
    </section>
    <section id="source" class="detail-section">
      <h2>GitHub 链接</h2>
      <p><a href={project.github} target="_blank" rel="noopener noreferrer">{project.githubName} ↗</a></p>
      {project.githubPrivate && <p class="muted">该仓库为私有仓库，仅获授权的 GitHub 账号可访问。实验摘要与项目介绍可在本网站查看。</p>}
    </section>
  </article>
</BaseLayout>
