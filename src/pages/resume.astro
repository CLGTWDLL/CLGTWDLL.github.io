---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="简历 / CV">
  <article class="container text-page">
    <h1>简历 / CV</h1>
    {profile.resumeUrl && <p><a href={profile.resumeUrl}>下载简历 PDF</a></p>}
    <dl class="result-list">
      <div><dt>姓名</dt><dd>{profile.name} / {profile.englishName}</dd></div>
      <div><dt>学校</dt><dd>{profile.university} · {profile.college} · {profile.educationPeriod}</dd></div>
      <div><dt>研究兴趣</dt><dd>{profile.interests.join(' / ')}</dd></div>
      <div><dt>邮箱</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
    </dl>
    <p><a href="/#projects">Engineering Projects</a> · <a href="/about/">About</a></p>
  </article>
</BaseLayout>
