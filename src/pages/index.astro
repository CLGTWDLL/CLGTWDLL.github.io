---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
const displayedAwards = [...profile.awards].sort((a, b) => Number(b.name === '国家奖学金') - Number(a.name === '国家奖学金'));
---
<BaseLayout>
  <section class="hero-banner" aria-labelledby="profile-name">
    <div class="campus-clip" aria-hidden="true"><img src="/images/cqu-library.jpg" alt="" width="2048" height="1442" decoding="async" /></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="profile-name">{profile.name}<span>{profile.englishName}</span></h1>
        <p class="affiliation">{profile.university} · {profile.college}<span class="affiliation-divider">|</span>{profile.interests.join(' / ')}</p>
        <div class="contact-links">
          <a href={`mailto:${profile.email}`}><Icon name="mail" size={21} />{profile.email}</a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={21} />GitHub ↗</a>
          <a href={profile.resumeUrl ?? '/resume/'}><Icon name="file" size={21} />简历 ↗</a>
        </div>
        <p class="biography">{profile.introduction}</p>
        <p class="hero-welcome">感谢您的关注，恳请批评指正，期待有机会向您学习与交流。</p>
      </div>
    </div>
  </section>
  <div class="container home-page">
    <div class="academic-grid">
      <section id="awards" class="info-panel awards-panel">
        <h2><Icon name="award" size={27} />Awards</h2>
        <ul class="awards-list">{displayedAwards.map(award => <li class:list={{ 'featured-award': award.name === '国家奖学金' }}><span>{award.name}</span>{award.year && <span class="award-year">{award.year}</span>}</li>)}</ul>
      </section>
      <section id="education" class="info-panel education-panel">
        <h2><Icon name="education" size={27} />Education</h2>
        <div class="education-timeline">
          <p><strong>{profile.university}</strong></p>
          <p class="education-english">{profile.universityEnglish}</p>
          <p>{profile.college}</p>
          {profile.major && <p>{profile.major}</p>}
          <p class="education-period">{profile.educationPeriod}</p>
        </div>
      </section>
      <section id="interests" class="info-panel interests-panel">
        <h2><Icon name="bulb" size={27} />Research Interests</h2>
        <ul class="interest-tags">
          {profile.interests.map(interest => <li>{interest}</li>)}
          <li>轮腿机构建模与控制</li>
          <li>感知部署及系统联调</li>
        </ul>
      </section>
    </div>
    <section id="projects" class="projects-section" aria-labelledby="projects-heading">
      <header class="section-header">
        <div><p class="section-kicker">工程项目</p><h2 id="projects-heading">Engineering Projects</h2></div>
      </header>
      {projects.map(project => <ProjectEntry project={project} />)}
    </section>
  </div>
</BaseLayout>
